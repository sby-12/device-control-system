<Window x:Class="MainSoftwareV100.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:MainSoftwareV100"
        xmlns:local="clr-namespace:MainSoftwareV100.MyControl"
        xmlns:oxy="http://oxyplot.org/wpf"
        mc:Ignorable="d"
        Height="1080" Width="1920"
        MinHeight="540" MinWidth="960"
        ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="False" 
        Background="Transparent" Icon="/HD.ico" Loaded="Window_Loaded" MouseLeftButtonDown="Window_MouseLeftButtonDown" 
        >
    <Window.DataContext>
        <loc:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D5078" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Cursor="Hand">
                            <Border x:Name="_Border" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            </Border>
                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}" Content="{TemplateBinding Content}" ContentStringFormat="{TemplateBinding ContentStringFormat}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <!--定义触发器-->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="_Border">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#ef3c62"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" TargetName="_Border">
                                    <Setter.Value>
                                        <SolidColorBrush Color="Gray"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                        <!--定义触发器_End-->
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>
    <Border Background="White" CornerRadius="10" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="0.34*"/>
                <RowDefinition Height="0.08*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0"  Grid.ColumnSpan="2" Margin="4" MinHeight="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="2"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Assest/Connect.png" Panel.ZIndex="1" Grid.Column="0" Style="{StaticResource imgStyle2}" ToolTip="IP连接" HorizontalAlignment="Left" VerticalAlignment="Center" Width="35" Height="34" MouseDown="IP_Connect" />
                    <Image Source="/Assest/保存.jpg" Panel.ZIndex="1" Grid.Column="0" Style="{StaticResource imgStyle2}" ToolTip="保存截图到示波器U盘" HorizontalAlignment="Left" VerticalAlignment="Center" Width="35" Height="34" Margin="50,0,0,0" MouseDown="SaveImage_MouseDown" Cursor="Hand"/>
                    <Image Source="/Assest/打开文件.jpg" Panel.ZIndex="1" Grid.Column="0" Style="{StaticResource imgStyle2}" ToolTip="数据导入" HorizontalAlignment="Left" VerticalAlignment="Center" Width="35" Height="34" Margin="100,0,0,0" RenderTransformOrigin="0.629,-0.343" />
                    <Label Content="双脉冲控制系统" Grid.Column="1" FontSize="25" Foreground="#FF686868" BorderBrush="#FFA0A0A0" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Image Source="/Assest/最小化.jpg" Panel.ZIndex="1" Grid.Column="3" Style="{StaticResource imgStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseDown="Image_MouseDown_2"  />
                    <Image Source="/Assest/最大化.png" Panel.ZIndex="1" Grid.Column="4" Style="{StaticResource imgStyle}"  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"/>
                    <Image Source="/Assest/退出.png" Panel.ZIndex="1" Grid.Column="5" Style="{StaticResource imgStyle}"  HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" MouseDown="Image_MouseDown" />
                </Grid>
            </Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="WhiteSmoke" Margin="2,2,2,2" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="电流源A设置"  Grid.Column="0" BorderBrush="LightGray" FontSize="16" FontWeight="Bold" Margin="10,2,2,10" >
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="电流：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="CurrentValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="A" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt24CurrentSet" Grid.Column="3" Grid.Row="0" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="电流设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt24CurrentSet_Click" />

                            <Label Content="限电流：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="LimitCurrentValue" FontSize="16" Grid.Column="1" Grid.Row="1" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="A" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt24LimitCurrentSet" Grid.Column="3" Grid.Row="1" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="限电流设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt24LimitCurrentSet_Click" />

                            <Label Content="电压：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="ValueValue" FontSize="16" Grid.Column="1" Grid.Row="2" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="V" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt24ValueSet" Grid.Column="3" Grid.Row="2" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="电压设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt24ValueSet_Click" />
                            <WrapPanel Grid.ColumnSpan="4" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                <Label Content="通道选择：" Foreground="#1E2E44" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                                <RadioButton x:Name="BtnCh1" FontSize="16" Content="通道1" Width="80" Margin="5,0" VerticalContentAlignment="Center" IsChecked="True" Checked="BtnCh1_Checked"/>
                                <RadioButton x:Name="BtnCh2" FontSize="16" Content="通道2" Width="80" Margin="5,0" VerticalContentAlignment="Center" Checked="BtnCh2_Checked" />
                                <Button x:Name="Btn24On"  FontSize="16"  Background="#FF2D5078" Foreground="White" Content="输出开" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Btn24On_Click" />
                                <Button x:Name="Btn24Off" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="输出关" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Btn24Off_Click" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="脉冲设置"  Grid.Column="2" BorderBrush="LightGray" FontSize="16" FontWeight="Bold" Margin="10,2,2,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="t1：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <local:NumericUpDown x:Name="t1TimeValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="1" Maximum="500"
     VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="1" SmallChange="1" />
                                <Label Content="us" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="t2：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <local:NumericUpDown x:Name="t2TimeValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="1" Maximum="1000"
VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="1" SmallChange="1" />
                                <Label Content="us" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </WrapPanel>
                            <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="t3：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <local:NumericUpDown x:Name="t3TimeValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="1" Maximum="1000"
VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="1" SmallChange="1" />
                                <Label Content="us" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <RadioButton x:Name="SingleRadio" FontSize="16" Content="单脉冲" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True"/>
                                <RadioButton x:Name="DoubleRadio" FontSize="16" Content="双脉冲"  Width="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Button x:Name="PlaseSet" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="脉冲设置" Width="100" Cursor="Hand" Margin="20,0,2,0" Click="PlaseSet_Click" />
                            </WrapPanel>
                            <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="幅值：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <local:NumericUpDown x:Name="DianYaValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="60" Margin="0" Height="24" Minimum="1" Maximum="15"
VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="1" SmallChange="1" />
                                <Label Content="V" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <Button x:Name="ValueSet" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="电压设置" Width="90" Cursor="Hand" Margin="20,0,2,0" Click="ValueSet_Click" />
                            </WrapPanel>
                        </Grid>

                    </GroupBox>
                    <GroupBox Header="电流源B设置"  Grid.Column="1" BorderBrush="LightGray" FontSize="16" FontWeight="Bold" Margin="10,2,2,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0.3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="电流：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="N36CurrentValue" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="A" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt36CurrentSet" Grid.Column="3" Grid.Row="0" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="电流设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt36CurrentSet_Click" />

                            <Label Content="限电流：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="N36LimitCurrentValue" FontSize="16" Grid.Column="1" Grid.Row="1" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="100"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="A" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt36LimitCurrentSet" Grid.Column="3" Grid.Row="1" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="限电流设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt36LimitCurrentSet_Click" />

                            <Label Content="电压：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <local:NumericUpDown x:Name="N36ValueValue" FontSize="16" Grid.Column="1" Grid.Row="2" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0" Maximum="2000"
                                VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="0.01" />
                            <Label Content="V" Foreground="#1E2E44" FontSize="16" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button x:Name="Bt36ValueSet" Grid.Column="3" Grid.Row="2" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="电压设置" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Bt36ValueSet_Click" />
                            <WrapPanel Grid.ColumnSpan="4" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" ContextMenuClosing="WrapPanel_ContextMenuClosing" >
                                <Button x:Name="Btn36On"  FontSize="16"  Background="#FF2D5078" Foreground="White" Content="输出开" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Btn36On_Click" />
                                <Button x:Name="Btn36Off" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="输出关" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="Btn36Off_Click" />
                                <Button x:Name="BtnTestff" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="正弦波" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="BtnTestff_Click"/>
                                <Button x:Name="BtnTestFanff" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="方波" Width="100" Cursor="Hand" Margin="2,0,2,0" Click="BtnTestFanff_Click"  />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                </Grid>


            </Border>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="WhiteSmoke" Margin="2,2,2,2" >
                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="电流源A电压:" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <TextBox Name="mN2410Value" Text="0.00"   Background="WhiteSmoke" Grid.Column="1" Grid.Row="0" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Foreground="#FF00CAFF"  FontWeight="Bold" FontSize="20" Margin="0,10,0,10"/>
                    <Label Content="V" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />

                    <Label Content="电流源A电流:" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="100,0,0,0" />
                    <TextBox Name="mN2410Current" Text="0.00"   Background="WhiteSmoke" Grid.Column="1" Grid.Row="0" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Foreground="#FF00CAFF"  FontWeight="Bold" FontSize="20" Margin="0,10,0,10"/>
                    <Label Content="A" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />

                    <Label Content="N3620电压:" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="100,0,0,0" />
                    <TextBox Name="mN3620Value" Text="0.00"   Background="WhiteSmoke" Grid.Column="1" Grid.Row="0" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Foreground="#FF00CAFF"  FontWeight="Bold" FontSize="20" Margin="0,10,0,10"/>
                    <Label Content="V" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />

                    <Label Content="N3620电流:" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="100,0,0,0" />
                    <TextBox Name="mN3620Current" Text="0.00"   Background="WhiteSmoke" Grid.Column="1" Grid.Row="0" Width="100" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Foreground="#FF00CAFF"  FontWeight="Bold" FontSize="20" Margin="0,10,0,10"/>
                    <Label Content="A" Foreground="Black"  Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" />
                </WrapPanel>
            </Border>
            <Border Grid.Row="3" Grid.ColumnSpan="2" Background="WhiteSmoke">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding SeriesList1}" Grid.Column="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                               
                                <CheckBox Content="{Binding Series1.Title}"
                                    IsChecked="{Binding IsVisible1, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0 0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <oxy:PlotView Model="{Binding PlotModel1}" Grid.Column="1"/>
                    <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center" Cursor="Hand">
                        <Label Content="曲线刷新显示栏：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CheckBox x:Name="CH1Display" Content="CH1" IsChecked="True" FontSize="16" Foreground="#1E2E44" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CH1Display_Checked" Unchecked="CH1Display_Unchecked" />
                        <CheckBox x:Name="CH2Display" Content="CH2" IsChecked="False" FontSize="16" Foreground="#1E2E44" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CH2Display_Checked" Unchecked="CH2Display_Unchecked"  />


                        <CheckBox x:Name="CH3Display" Content="CH3" IsChecked="False" FontSize="16" Foreground="#1E2E44" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CH3Display_Checked" Unchecked="CH3Display_Unchecked" />
                        <CheckBox x:Name="CH4Display" Content="CH4" IsChecked="False" FontSize="16" Foreground="#1E2E44" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="CH4Display_Checked" Unchecked="CH4Display_Unchecked"/>
                        <Button x:Name="StartUpDate" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="启动刷新"  Width="100" Cursor="Hand" Margin="10,0,2,0" Click="StartUpDate_Click" />
                        <Button x:Name="StoptUpDate" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="暂停刷新"  Width="100" Cursor="Hand" Margin="5,0,2,0" Click="StoptUpDate_Click"/>
                        <Button x:Name="SavetUpDate" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="保存数据"  Width="100" Cursor="Hand" Margin="5,0,2,0" Click="SavetUpDate_Click"/>
                        <Button x:Name="DeepSave" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="深度保存"  Width="100" Cursor="Hand" Margin="5,0,2,0" Click="DeepSave_Click"/>
                        <Button x:Name="OpenAiAssistant" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="AI助手"  Width="80" Cursor="Hand" Margin="5,0,2,0" Click="OpenAiAssistant_Click"/>
                        <Button x:Name="OpenDptAnalysis" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="参数提取"  Width="90" Cursor="Hand" Margin="5,0,2,0" Click="OpenDptAnalysis_Click"/>

                        <Label Content="触发设置栏：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <RadioButton x:Name="UpRadio" FontSize="16" Content="上升沿" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True"/>
                        <RadioButton x:Name="DownRadio" FontSize="16" Content="下降沿"  Width="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="SingleDegSet" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="边沿"  Width="60" Cursor="Hand" Margin="10,0,2,0" Click="SingleDegSet_Click" />
                        <Button x:Name="SinglSourceSet" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="触发源"  Width="80" Cursor="Hand" Margin="10,0,2,0" Click="SinglSourceSet_Click" />
                        <Label Content="触发电压：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="ValueTrigger" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="80" Margin="0" Height="24" Minimum="-10" Maximum="10"
      VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="1" ValueChanged="ValueChange_ValueChanged" />
                        <Label Content="V" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="SinglLevelSet" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="触发电压"  Width="100" Cursor="Hand" Margin="20,0,2,0" Click="SinglLevelSet_Click"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="参数设置栏：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Label Content="电压变换：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="ValueChange" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0.0001" Maximum="10000"
                             VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="1" ValueChanged="ValueChange_ValueChanged" />
                        <Label Content="V/div" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Label Content="电压偏移：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="ValueOffset" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="-10000" Maximum="10000"
     VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="1" ValueChanged="ValueOffset_ValueChanged" />
                        <Label Content="V" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Label Content="时间偏移：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="TimeOffsetChange" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="-1000000" Maximum="1000000"
     VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="1" ValueChanged="TimeOffsetChange_ValueChanged" />
                        <Label Content="us" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Label Content="探头倍率：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="ProbeChange" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="1" Maximum="1000"
     VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="10" SmallChange="1" ValueChanged="ProbeChange_ValueChanged" />
                        <Label Content="X" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <RadioButton x:Name="Imped50Radio" GroupName="ImpedGroup" FontSize="16" Content="50Ω" Width="60" VerticalAlignment="Center" HorizontalAlignment="Center" Click="ImpedRadio_Click"/>
                        <RadioButton x:Name="Imped1MRadio" GroupName="ImpedGroup" FontSize="16" Content="1MΩ" Width="60" VerticalAlignment="Center" HorizontalAlignment="Center" Click="ImpedRadio_Click"/>
                        <Label Content="时间变换：" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <local:NumericUpDown x:Name="TimeChange" FontSize="16" Grid.Column="1" Grid.Row="0" Foreground="#1E2E44" MinWidth="100" Margin="0" Height="24" Minimum="0.001" Maximum="10000"
     VerticalAlignment="Center" HorizontalAlignment="Center" LargeChange="0.01" SmallChange="1" ValueChanged="TimeChange_ValueChanged" />
                        <Label Content="us/div" FontSize="16" Foreground="#1E2E44" Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <RadioButton x:Name="Ch1Radio" FontSize="16" Content="CH1" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" IsChecked="True"/>
                        <RadioButton x:Name="Ch2Radio" FontSize="16" Content="CH2"  Width="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <RadioButton x:Name="Ch3Radio" FontSize="16" Content="CH3" Width="50" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <RadioButton x:Name="Ch4Radio" FontSize="16" Content="CH4"  Width="50" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button x:Name="BtnStart"  FontSize="16"  Background="#FF2D5078" Foreground="White" Content="RUN" Width="50" Cursor="Hand" Margin="2,0,2,0" Click="BtnStart_Click" />
                        <Button x:Name="BtnStop" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="STOP" Width="50" Cursor="Hand" Margin="2,0,2,0" Click="BtnStop_Click" />
                        <Button x:Name="BtnAuto" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="AUTO" Width="50" Cursor="Hand" Margin="2,0,2,0" Click="BtnAuto_Click" />
                        <Button x:Name="BtnSingle" FontSize="16"  Background="#FF2D5078" Foreground="White" Content="SINGLE" Width="65" Cursor="Hand" Margin="2,0,2,0" Click="BtnSingle_Click"/>
                    </WrapPanel>
                </Grid>

            </Border>
            <Border Grid.Row="4" Grid.ColumnSpan="2" Background="WhiteSmoke">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80*"/>
                        <ColumnDefinition Width="80*"/>
                        <ColumnDefinition Width="53*"/>
                        <ColumnDefinition Width="27*"/>
                        <ColumnDefinition Width="80*"/>
                        <ColumnDefinition Width="160*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="电流源A未连接" x:Name="mEleN2410Status" Grid.Column="0" FontSize="14" Margin="15,2,15,2"/>
                    <TextBlock Text="电流源B未连接" x:Name="mEleN3620State" Grid.Column="1" FontSize="14" Margin="15,2,15,2"/>
                    <TextBlock Text="示波器未连接" x:Name="ShiBoState" Grid.Column="2" FontSize="14" Margin="15,2,15,2" Grid.ColumnSpan="2"/>
                    <TextBlock Text="信号源未连接" x:Name="SourceState" Grid.Column="4" FontSize="14" Margin="15,2,15,2"/>
                    <local:MyTime x:Name="mWarningLed" Grid.Column="5" HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
